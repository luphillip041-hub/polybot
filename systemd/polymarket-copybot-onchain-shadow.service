# Polygon on-chain paper-signal source and Data API reconciliation lane.
# Reads public RPC, archive metadata, Data API shadow files, and paper allowlist.
# Writes only runs/onchain_shadow; it cannot write paper ledger/state/allowlist.
[Unit]
Description=Polymarket Polygon On-chain Paper Signal Source
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/flip/projects/polymarket-copybot
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=POLYGON_WSS_RPC_URL=wss://polygon-bor-rpc.publicnode.com
Environment=POLYGON_WSS_FALLBACK_URLS=wss://polygon.drpc.org
Environment=POLYGON_HTTP_RPC_URL=https://polygon-bor-rpc.publicnode.com
Environment=POLYGON_HTTP_FALLBACK_URLS=https://polygon.drpc.org
Environment=ONCHAIN_CONFIRMATIONS=6
Environment=ONCHAIN_HEAD_STALE_SECONDS=30
Environment=ONCHAIN_PAPER_FOLLOWER_INTEGRATED=true
EnvironmentFile=-/etc/polymarket-copybot-onchain-shadow.env
ExecStart=/root/flip/projects/polymarket-copybot/.venv/bin/python -m polymarket_bot.onchain_shadow_worker
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/flip/projects/polymarket-copybot/runs/onchain_shadow
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
